flowchart LR
  A([source bytes]) --> B[hash + store]
  B --> C{validate}
  C -->|tier 0| D[parse counts]
  C -->|tier 1| E[browser verify]
  D --> F([verdict])
  E --> F

  %% hue is semantic only — apply sparingly
  classDef ok stroke:#c3e88d,color:#c3e88d
  classDef warn stroke:#ffc777,color:#ffc777
  classDef fail stroke:#ff757f,color:#ff757f
  classDef accent stroke:#86e1fc,color:#86e1fc
  class F ok
