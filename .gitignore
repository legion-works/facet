node_modules/
dist/
*.log
.facet-runtime/
coverage/

# Local test run output (JUnit XML, gallery-geometry screenshots). CI
# uploads these as workflow artifacts; they never belong in history.
test-results/

# Local build context — never committed.
.facet-build/

# Operator-owned archives dropped in the working tree. Ignored so a broad
# `git add -A` cannot sweep one into history, where the blob would persist
# after any later removal.
*.zip
*.tgz
.facet-tsx-worker/

# Resolver test fixtures. Probe TSX files are written under this dir and
# cleaned by the test's afterEach hook; keeping the dir itself untracked
# stops a stray file from being swept into history on a follow-up commit.
tests/fixtures/tsx/_resolver-probes/
